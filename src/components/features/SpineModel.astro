---
import MessageBox from "@/components/common/PioMessageBox.astro";
import { spineModelConfig } from "@/config/pioConfig";
import { url } from "@/utils/url-utils";
---

<!-- Spine Web Player CSS 将在 script 中动态加载 -->{
  spineModelConfig.enable && (
    <div
      id="spine-model-container"
      style={`
      position: fixed;
      ${spineModelConfig.position.corner.includes("right") ? "right" : "left"}: ${spineModelConfig.position.offsetX}px;
      ${spineModelConfig.position.corner.includes("top") ? "top" : "bottom"}: ${spineModelConfig.position.offsetY}px;
      width: ${spineModelConfig.size.width}px;
      height: ${spineModelConfig.size.height}px;
      pointer-events: auto;
      z-index: 1000;
      cursor: grab;
      touch-action: none;
      user-select: none;
    `}
    >
      <div id="spine-player-container" style="width: 100%; height: 100%;" />
      <div id="spine-error" style="display: none;" />
      <button
        id="spine-toggle"
        title="收起 / 展开看板娘"
        style={`
          position: absolute; top: -6px; right: -6px;
          width: 24px; height: 24px; border-radius: 50%;
          border: 1px solid rgba(200,150,255,.45);
          background: rgba(30,18,44,.92); color: #d9b8ff;
          font-size: 13px; line-height: 1; cursor: pointer;
          display: flex; align-items: center; justify-content: center;
          z-index: 1002; backdrop-filter: blur(6px);
        `}>－</button>
    </div>
  )
}

<!-- 引入消息框组件 -->
{spineModelConfig.enable && <MessageBox />}

{spineModelConfig.enable && (
<script is:inline define:vars={{ spineModelConfig, modelPath: url(spineModelConfig.model.path), atlasPath: url(spineModelConfig.model.path.replace(".json", ".atlas")), cssPath: url("/pio/static/spine-player.min.css"), jsPath: url("/pio/static/spine-player.min.js") }}>
  // 动态加载 Spine CSS（带本地备用）
  function loadSpineCSS() {
    if (!spineModelConfig.enable) return;
    const existingLink = document.querySelector('link[href*="spine-player"]');
    if (existingLink) return;

    const cdnLink = document.createElement("link");
    cdnLink.rel = "stylesheet";
    cdnLink.href =
      "https://unpkg.com/@esotericsoftware/spine-player@4.2.*/dist/spine-player.min.css";

    cdnLink.onerror = function () {
      console.warn("⚠️ Spine CSS CDN failed, trying local fallback...");
      if (cdnLink.parentNode) cdnLink.parentNode.removeChild(cdnLink);
      const localLink = document.createElement("link");
      localLink.rel = "stylesheet";
      localLink.href = cssPath;
      localLink.onerror = function () {
        console.error("❌ Failed to load Spine CSS");
      };
      document.head.appendChild(localLink);
    };

    document.head.appendChild(cdnLink);
  }

  let isClickProcessing = false;
  let lastClickTime = 0;

  window.spineModelInitialized = window.spineModelInitialized || false;
  window.spinePlayerInstance = window.spinePlayerInstance || null;

  function showMessage(message) {
    if (window.showModelMessage) {
      window.showModelMessage(message, {
        containerId: "spine-model-container",
        displayTime: spineModelConfig.interactive.messageDisplayTime || 3000
      });
    }
  }

  function updateResponsiveDisplay() {
    if (!spineModelConfig.enable) return;
    const container = document.getElementById("spine-model-container");
    if (!container) return;
    if (
      spineModelConfig.responsive.hideOnMobile &&
      window.innerWidth <= spineModelConfig.responsive.mobileBreakpoint
    ) {
      container.style.display = "none";
    } else {
      container.style.display = "block";
    }
  }

  function cleanupSpineModel() {
    if (window.clearModelMessage) window.clearModelMessage();
    if (window.spinePlayerInstance) {
      try {
        if (window.spinePlayerInstance.dispose) window.spinePlayerInstance.dispose();
      } catch (e) {
        console.warn("Error disposing spine player:", e);
      }
      window.spinePlayerInstance = null;
    }
    const playerContainer = document.getElementById("spine-player-container");
    if (playerContainer) playerContainer.innerHTML = "";
    window.spineModelInitialized = false;
  }

  async function initSpineModel() {
    if (!spineModelConfig.enable) return;

    if (
      spineModelConfig.responsive.hideOnMobile &&
      window.innerWidth <= spineModelConfig.responsive.mobileBreakpoint
    ) {
      const container = document.getElementById("spine-model-container");
      if (container) container.style.display = "none";
      return;
    }

    if (window.spineModelInitialized) return;

    cleanupSpineModel();
    loadSpineCSS();

    const loadSpineRuntime = () => {
      return new Promise((resolve, reject) => {
        if (typeof window.spine !== "undefined") {
          resolve();
          return;
        }
        const script = document.createElement("script");
        script.src =
          "https://unpkg.com/@esotericsoftware/spine-player@4.2.*/dist/iife/spine-player.min.js";
        script.onload = () => resolve();
        script.onerror = () => {
          console.warn("⚠️ CDN failed, trying local fallback...");
          const fallbackScript = document.createElement("script");
          fallbackScript.src = jsPath;
          fallbackScript.onload = () => resolve();
          fallbackScript.onerror = () => reject(new Error("Failed to load Spine runtime"));
          document.head.appendChild(fallbackScript);
        };
        document.head.appendChild(script);
      });
    };

    const waitForSpine = () => {
      return new Promise((resolve, reject) => {
        let attempts = 0;
        const maxAttempts = 50;
        const check = () => {
          attempts++;
          if (typeof window.spine !== "undefined" && window.spine.SpinePlayer) {
            resolve();
          } else if (attempts >= maxAttempts) {
            reject(new Error("Spine runtime loading timeout"));
          } else {
            setTimeout(check, 100);
          }
        };
        check();
      });
    };

    try {
      await loadSpineRuntime();
      await waitForSpine();
      window.spineModelInitialized = true;

      new window.spine.SpinePlayer("spine-player-container", {
        skeleton: modelPath,
        atlas: atlasPath,
        animation: "idle",
        backgroundColor: "#00000000",
        showControls: false,
        alpha: true,
        premultipliedAlpha: false,
        success: (player) => {
          window.spinePlayerInstance = player;

          const availableAnimations = new Set(
            (player.skeleton?.data?.animations || [])
              .map((anim) => anim?.name)
              .filter(Boolean)
          );

          const pickRandom = (list) => list[Math.floor(Math.random() * list.length)];

          const configuredClickAnims =
            spineModelConfig.interactive.clickAnimations ||
            (spineModelConfig.interactive.clickAnimation
              ? [spineModelConfig.interactive.clickAnimation]
              : []);

          const configuredIdleAnims =
            spineModelConfig.interactive.idleAnimations || ["idle"];

          const validClickAnims = configuredClickAnims.filter((name) =>
            availableAnimations.has(name)
          );
          const validIdleAnims = configuredIdleAnims.filter((name) =>
            availableAnimations.has(name)
          );

          const fallbackIdleAnim =
            (availableAnimations.has("idle") && "idle") ||
            validIdleAnims[0] ||
            configuredIdleAnims[0] ||
            configuredClickAnims[0] ||
            Array.from(availableAnimations)[0];

          const safeSetAnimation = (name, loop) => {
            if (!name || !availableAnimations.has(name)) return false;
            try {
              player.setAnimation(name, loop);
              return true;
            } catch (e) {
              console.warn(`Failed to play animation: ${name}`, e);
              return false;
            }
          };

          if (!safeSetAnimation("idle", true) && fallbackIdleAnim) {
            safeSetAnimation(fallbackIdleAnim, true);
          }

          setTimeout(() => {
            if (player.skeleton) {
              try {
                player.skeleton.setToSetupPose();
                const physicsMode =
                  window.spine?.Physics?.update ??
                  window.spine?.Physics?.pose ??
                  window.spine?.Physics?.none ??
                  0;
                player.skeleton.updateWorldTransform(physicsMode);
              } catch (e) {
                console.warn("Error positioning skeleton:", e);
              }
            }
          }, 500);

          if (spineModelConfig.interactive.enabled) {
            const canvas = document.querySelector("#spine-player-container canvas");
            if (canvas) {
              canvas.addEventListener("click", () => {
                const currentTime = Date.now();
                if (isClickProcessing || currentTime - lastClickTime < 500) return;
                isClickProcessing = true;
                lastClickTime = currentTime;

                if (validClickAnims.length > 0) {
                  safeSetAnimation(pickRandom(validClickAnims), false);
                  setTimeout(() => {
                    const randomIdle =
                      validIdleAnims.length > 0
                        ? pickRandom(validIdleAnims)
                        : fallbackIdleAnim;
                    safeSetAnimation(randomIdle, true);
                  }, 2000);
                } else if (fallbackIdleAnim) {
                  safeSetAnimation(fallbackIdleAnim, true);
                }

                const messages = spineModelConfig.interactive.clickMessages;
                if (messages && messages.length > 0) {
                  showMessage(messages[Math.floor(Math.random() * messages.length)]);
                }

                setTimeout(() => {
                  isClickProcessing = false;
                }, 500);
              });

              if (validIdleAnims.length > 1) {
                setInterval(() => {
                  safeSetAnimation(pickRandom(validIdleAnims), true);
                }, spineModelConfig.interactive.idleInterval);
              }
            }
          }
        },
        error: (_player, reason) => {
          console.error("❌ Spine model loading error:", reason);
          const errorDiv = document.getElementById("spine-error");
          if (errorDiv) {
            errorDiv.style.display = "block";
            errorDiv.innerHTML = `
              <div style="color: #ff4444; padding: 20px; text-align: center; font-size: 14px;">
                <div>⚠️ Spine 模型加载失败</div>
                <div style="font-size: 12px; margin-top: 8px; color: #888;">${reason}</div>
              </div>
            `;
          }
        },
      });
    } catch (error) {
      console.error("Spine model initialization error:", error);
      window.spineModelInitialized = false;
      const errorDiv = document.getElementById("spine-error");
      if (errorDiv) {
        errorDiv.style.display = "block";
        errorDiv.innerHTML = `
          <div style="color: #ff4444; padding: 20px; text-align: center; font-size: 14px;">
            <div>⚠️ Spine 运行时加载失败</div>
            <div style="font-size: 12px; margin-top: 8px; color: #888;">${error instanceof Error ? error.message : "未知错误"}</div>
          </div>
        `;
      }
    }
  }

  /* ---------- 拖动 + 缩放 + 最小化 ---------- */
  function setupDragAndToggle() {
    const container = document.getElementById("spine-model-container");
    const toggle = document.getElementById("spine-toggle");
    if (!container || !toggle) return;

    // 右下角缩放手柄
    let handle = document.getElementById("spine-resize");
    if (!handle) {
      handle = document.createElement("div");
      handle.id = "spine-resize";
      handle.title = "拖动调整大小";
      handle.style.cssText =
        "position:absolute;right:-3px;bottom:-3px;width:18px;height:18px;border-radius:4px;" +
        "background:linear-gradient(135deg,rgba(180,120,255,.9),rgba(230,120,190,.9));" +
        "border:1px solid rgba(255,255,255,.55);cursor:nwse-resize;z-index:1003;touch-action:none;";
      container.appendChild(handle);
    }

    // 恢复上次位置和尺寸
    try {
      const saved = JSON.parse(localStorage.getItem("spine-pos") || "null");
      if (saved && typeof saved.left === "number") {
        container.style.left = saved.left + "px";
        container.style.top = saved.top + "px";
        container.style.right = "auto";
        container.style.bottom = "auto";
      }
      const savedSize = JSON.parse(localStorage.getItem("spine-size") || "null");
      if (savedSize && savedSize.w) {
        container.style.width = savedSize.w + "px";
        container.style.height = savedSize.h + "px";
        container.dataset.w = savedSize.w;
        container.dataset.h = savedSize.h;
      }
      if (localStorage.getItem("spine-minimized") === "1") {
        container.classList.add("spine-minimized");
        toggle.textContent = "◉";
        container.dataset.prevW = container.style.width;
        container.dataset.prevH = container.style.height;
        container.style.width = "30px";
        container.style.height = "30px";
      }
    } catch (e) {}

    function applySize(w, h) {
      w = Math.max(120, Math.min(620, Math.round(w)));
      h = Math.max(150, Math.min(780, Math.round(h)));
      container.style.width = w + "px";
      container.style.height = h + "px";
      container.dataset.w = w;
      container.dataset.h = h;
      const player = window.spinePlayerInstance;
      if (player && typeof player.resize === "function") {
        try { player.resize(w, h); } catch (e) {}
      }
      const canvas = document.querySelector("#spine-player-container canvas");
      if (canvas) {
        canvas.style.width = "100%";
        canvas.style.height = "100%";
      }
    }

    let sx = 0, sy = 0, ol = 0, ot = 0, dragging = false, moved = false;

    container.addEventListener("pointerdown", (e) => {
      if (e.target === toggle || e.target === handle) return;
      const r = container.getBoundingClientRect();
      container.style.left = r.left + "px";
      container.style.top = r.top + "px";
      container.style.right = "auto";
      container.style.bottom = "auto";
      sx = e.clientX; sy = e.clientY;
      ol = r.left; ot = r.top;
      dragging = true; moved = false;
      container.style.cursor = "grabbing";
      try { container.setPointerCapture(e.pointerId); } catch (err) {}
    });

    container.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true;
      container.style.left = ol + dx + "px";
      container.style.top = ot + dy + "px";
    });

    function endDrag(e) {
      if (!dragging) return;
      dragging = false;
      container.style.cursor = "grab";
      try { container.releasePointerCapture(e.pointerId); } catch (err) {}
      if (moved) {
        try {
          localStorage.setItem("spine-pos", JSON.stringify({
            left: parseFloat(container.style.left),
            top: parseFloat(container.style.top)
          }));
        } catch (err) {}
      }
    }
    container.addEventListener("pointerup", endDrag);
    container.addEventListener("pointercancel", endDrag);

    // 缩放手柄
    let resizing = false, rw = 0, rh = 0, rx = 0, ry = 0;
    handle.addEventListener("pointerdown", (e) => {
      e.stopPropagation();
      e.preventDefault();
      const r = container.getBoundingClientRect();
      resizing = true;
      rw = r.width; rh = r.height;
      rx = e.clientX; ry = e.clientY;
      try { handle.setPointerCapture(e.pointerId); } catch (err) {}
    });
    handle.addEventListener("pointermove", (e) => {
      if (!resizing) return;
      e.stopPropagation();
      applySize(rw + (e.clientX - rx), rh + (e.clientY - ry));
    });
    function endResize(e) {
      if (!resizing) return;
      resizing = false;
      try { handle.releasePointerCapture(e.pointerId); } catch (err) {}
      try {
        localStorage.setItem("spine-size", JSON.stringify({
          w: parseInt(container.style.width, 10),
          h: parseInt(container.style.height, 10)
        }));
      } catch (err) {}
    }
    handle.addEventListener("pointerup", endResize);
    handle.addEventListener("pointercancel", endResize);

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const mini = container.classList.toggle("spine-minimized");
      toggle.textContent = mini ? "◉" : "－";
      try { localStorage.setItem("spine-minimized", mini ? "1" : "0"); } catch (err) {}
      if (mini) {
        container.dataset.prevW = container.style.width;
        container.dataset.prevH = container.style.height;
        container.style.width = "30px";
        container.style.height = "30px";
      } else {
        container.style.width = (container.dataset.w ? container.dataset.w + "px" : container.dataset.prevW);
        container.style.height = (container.dataset.h ? container.dataset.h + "px" : container.dataset.prevH);
        const player = window.spinePlayerInstance;
        if (player && typeof player.resize === "function") {
          try {
            player.resize(parseInt(container.style.width, 10), parseInt(container.style.height, 10));
          } catch (err) {}
        }
      }
    });

    const style = document.createElement("style");
    style.textContent = `
      #spine-model-container.spine-minimized #spine-player-container { display: none !important; }
      #spine-model-container.spine-minimized #spine-resize { display: none !important; }
      #spine-model-container.spine-minimized { opacity: .9; }
    `;
    document.head.appendChild(style);
  }

  window.addEventListener("beforeunload", cleanupSpineModel);

  if (typeof window.swup !== "undefined" && window.swup.hooks) {
    window.swup.hooks.on("content:replace", () => {
      setTimeout(() => {
        updateResponsiveDisplay();
        setupDragAndToggle();
      }, 100);
    });
  }

  window.addEventListener("popstate", () => {
    setTimeout(() => updateResponsiveDisplay(), 100);
  });

  window.addEventListener("resize", updateResponsiveDisplay);

  function boot() {
    initSpineModel();
    setupDragAndToggle();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>
)}
