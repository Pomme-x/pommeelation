---
// 自定义 Live2D 看板娘（pixi-live2d-display + Cubism 5 Core，兼容 moc3 v5）
---

<div
	id="l2d-pet"
	style="position:fixed;right:20px;bottom:20px;width:320px;height:400px;z-index:1000;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none;"
>
	<div id="l2d-pet-canvas" style="width:100%;height:100%;"></div>
	<div
		id="l2d-pet-loading"
		style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#c9a8ff;font-size:12px;background:rgba(20,12,30,.85);padding:8px 14px;border-radius:8px;border:1px solid rgba(200,150,255,.3);"
		>看板娘加载中…</div
	>
	<button
		id="l2d-pet-toggle"
		title="收起 / 展开"
		style="position:absolute;top:-2px;right:-2px;width:24px;height:24px;border-radius:50%;border:1px solid rgba(200,150,255,.45);background:rgba(30,18,44,.92);color:#d9b8ff;font-size:13px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:3;backdrop-filter:blur(6px);"
		>－</button
	>
	<div
		id="l2d-pet-resize"
		title="拖动调整大小"
		style="position:absolute;right:-2px;bottom:-2px;width:18px;height:18px;border-radius:4px;background:linear-gradient(135deg,rgba(180,120,255,.9),rgba(230,120,190,.9));border:1px solid rgba(255,255,255,.55);cursor:nwse-resize;z-index:3;touch-action:none;"
	>
	</div>
</div>

<script is:inline define:vars={{ modelPath: "/pio/models/live2d/robin/robin.model3.json" }}>
	(function () {
		const box = document.getElementById("l2d-pet");
		const canvasBox = document.getElementById("l2d-pet-canvas");
		const loading = document.getElementById("l2d-pet-loading");
		const toggle = document.getElementById("l2d-pet-toggle");
		const handle = document.getElementById("l2d-pet-resize");
		if (!box || !canvasBox) return;

		const MIN = 140, MAX = 620;

		function applySize(w, h) {
			w = Math.max(MIN, Math.min(MAX, Math.round(w)));
			h = Math.max(MIN, Math.min(MAX * 1.4, Math.round(h)));
			box.style.width = w + "px";
			box.style.height = h + "px";
			box.dataset.w = w;
			box.dataset.h = h;
			if (window.__l2dApp) {
				try {
					window.__l2dApp.renderer.resize(w, h);
					fitModel();
				} catch (e) {}
			}
		}

		function fitModel() {
			const model = window.__l2dModel;
			const app = window.__l2dApp;
			if (!model || !app) return;
			const sw = app.screen.width, sh = app.screen.height;
			const mw = model.width, mh = model.height;
			if (!mw || !mh) return;
			const s = Math.min(sw / mw, sh / mh) * 1.05;
			model.scale.set(s);
			model.x = (sw - mw * s) / 2;
			model.y = (sh - mh * s) / 2 + mh * s * 0.08;
		}

		function loadScript(src) {
			return new Promise((resolve, reject) => {
				if (document.querySelector('script[src="' + src + '"]')) return resolve();
				const s = document.createElement("script");
				s.src = src;
				s.async = false;
				s.onload = resolve;
				s.onerror = () => reject(new Error("加载失败：" + src));
				document.head.appendChild(s);
			});
		}

		async function boot() {
			try {
				await loadScript("https://cdn.jsdelivr.net/npm/pixi.js@6.5.10/dist/browser/pixi.min.js");
				await loadScript("https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js");
				await loadScript("https://cdn.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js");

				const w = parseInt(box.style.width, 10) || 320;
				const h = parseInt(box.style.height, 10) || 400;
				const app = new PIXI.Application({
					width: w,
					height: h,
					backgroundAlpha: 0,
					antialias: true,
					autoDensity: true,
					resolution: Math.min(window.devicePixelRatio || 1, 2),
				});
				window.__l2dApp = app;
				canvasBox.appendChild(app.view);

				const model = await PIXI.live2d.Live2DModel.from(modelPath, { autoInteract: true });
				window.__l2dModel = model;
				app.stage.addChild(model);
				fitModel();

				// 点击随机播表情
				const exprs = ["holding", "chest", "mic"];
				app.view.addEventListener("click", () => {
					try {
						const name = exprs[Math.floor(Math.random() * exprs.length)];
						if (model.internalModel && model.internalModel.motionManager) {
							// 优先播动作
						}
						if (model.internalModel && model.internalModel.expressionManager) {
							model.expression(name);
						}
					} catch (e) {}
				});

				loading.style.display = "none";
			} catch (err) {
				loading.textContent = "加载失败：" + err.message;
				console.error(err);
			}
		}

		// 恢复状态
		try {
			const p = JSON.parse(localStorage.getItem("l2dpet-pos") || "null");
			if (p && typeof p.left === "number") {
				box.style.left = p.left + "px";
				box.style.top = p.top + "px";
				box.style.right = "auto";
				box.style.bottom = "auto";
			}
			const s = JSON.parse(localStorage.getItem("l2dpet-size") || "null");
			if (s && s.w) {
				box.style.width = s.w + "px";
				box.style.height = s.h + "px";
				box.dataset.w = s.w;
				box.dataset.h = s.h;
			}
			if (localStorage.getItem("l2dpet-mini") === "1") {
				box.classList.add("l2dpet-mini");
				toggle.textContent = "◉";
				box.dataset.prevW = box.style.width;
				box.dataset.prevH = box.style.height;
				box.style.width = "34px";
				box.style.height = "34px";
			}
		} catch (e) {}

		const st = document.createElement("style");
		st.textContent =
			"#l2d-pet.l2dpet-mini #l2d-pet-canvas{display:none!important}" +
			"#l2d-pet.l2dpet-mini #l2d-pet-resize{display:none!important}" +
			"#l2d-pet.l2dpet-mini #l2d-pet-loading{display:none!important}" +
			"#l2d-pet canvas{display:block}";
		document.head.appendChild(st);

		// 拖动
		let sx = 0, sy = 0, ol = 0, ot = 0, dragging = false, moved = false;
		box.addEventListener("pointerdown", (e) => {
			if (e.target === toggle || e.target === handle) return;
			const r = box.getBoundingClientRect();
			box.style.left = r.left + "px";
			box.style.top = r.top + "px";
			box.style.right = "auto";
			box.style.bottom = "auto";
			sx = e.clientX; sy = e.clientY; ol = r.left; ot = r.top;
			dragging = true; moved = false;
			box.style.cursor = "grabbing";
			try { box.setPointerCapture(e.pointerId); } catch (err) {}
		});
		box.addEventListener("pointermove", (e) => {
			if (!dragging) return;
			const dx = e.clientX - sx, dy = e.clientY - sy;
			if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true;
			box.style.left = ol + dx + "px";
			box.style.top = ot + dy + "px";
		});
		function endDrag(e) {
			if (!dragging) return;
			dragging = false;
			box.style.cursor = "grab";
			try { box.releasePointerCapture(e.pointerId); } catch (err) {}
			if (moved) {
				try {
					localStorage.setItem("l2dpet-pos", JSON.stringify({ left: parseFloat(box.style.left), top: parseFloat(box.style.top) }));
				} catch (err) {}
			}
		}
		box.addEventListener("pointerup", endDrag);
		box.addEventListener("pointercancel", endDrag);

		// 缩放
		let resizing = false, rw = 0, rh = 0, rx = 0, ry = 0;
		handle.addEventListener("pointerdown", (e) => {
			e.stopPropagation();
			e.preventDefault();
			const r = box.getBoundingClientRect();
			resizing = true; rw = r.width; rh = r.height; rx = e.clientX; ry = e.clientY;
			try { handle.setPointerCapture(e.pointerId); } catch (err) {}
		});
		handle.addEventListener("pointermove", (e) => {
			if (!resizing) return;
			e.stopPropagation();
			applySize(rw + (e.clientX - rx), rh + (e.clientY - ry));
		});
		function endResize(e) {
			if (!resizing) return;
			resizing = false;
			try { handle.releasePointerCapture(e.pointerId); } catch (err) {}
			try {
				localStorage.setItem("l2dpet-size", JSON.stringify({ w: parseInt(box.style.width, 10), h: parseInt(box.style.height, 10) }));
			} catch (err) {}
		}
		handle.addEventListener("pointerup", endResize);
		handle.addEventListener("pointercancel", endResize);

		toggle.addEventListener("click", (e) => {
			e.stopPropagation();
			const mini = box.classList.toggle("l2dpet-mini");
			toggle.textContent = mini ? "◉" : "－";
			try { localStorage.setItem("l2dpet-mini", mini ? "1" : "0"); } catch (err) {}
			if (mini) {
				box.dataset.prevW = box.style.width;
				box.dataset.prevH = box.style.height;
				box.style.width = "34px";
				box.style.height = "34px";
			} else {
				const w = box.dataset.w ? parseInt(box.dataset.w, 10) : 320;
				const h = box.dataset.h ? parseInt(box.dataset.h, 10) : 400;
				box.style.width = w + "px";
				box.style.height = h + "px";
				applySize(w, h);
			}
		});

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", boot);
		} else {
			boot();
		}
	})();
</script>
