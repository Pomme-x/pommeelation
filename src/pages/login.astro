---
// 登录页：不继承主题布局，独立全屏卡片
export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>登录 · 欢愉剧场</title>
		<style is:global>
			* { box-sizing: border-box; }
			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: system-ui, -apple-system, "Microsoft YaHei UI", sans-serif;
				background: #120a1d url("/assets/images/DesktopWallpaper/h4.webp") center/cover no-repeat;
			}
			body::before {
				content: "";
				position: fixed;
				inset: 0;
				background: radial-gradient(circle at 50% 40%, rgba(90, 30, 120, .45), rgba(10, 6, 16, .82));
				pointer-events: none;
			}
			.card {
				position: relative;
				width: min(92vw, 380px);
				padding: 34px 30px 26px;
				border-radius: 20px;
				background: rgba(28, 18, 40, .72);
				border: 1px solid rgba(200, 150, 255, .22);
				box-shadow: 0 24px 70px rgba(0, 0, 0, .55), inset 0 1px 0 rgba(255,255,255,.06);
				backdrop-filter: blur(16px);
				color: #f2e9ff;
			}
			h1 { margin: 0 0 6px; font-size: 22px; letter-spacing: .04em; }
			.dot { color: #c86bff; }
			.sub { margin: 0 0 22px; font-size: 12.5px; color: #b49bc8; }
			.field { margin-bottom: 14px; }
			label { display: block; font-size: 12px; color: #c9b4dc; margin-bottom: 6px; }
			input {
				width: 100%;
				padding: 11px 13px;
				border-radius: 10px;
				border: 1px solid rgba(200, 150, 255, .2);
				background: rgba(12, 8, 18, .7);
				color: #fff;
				font-size: 14px;
				outline: none;
				transition: border-color .2s, box-shadow .2s;
			}
			input:focus { border-color: #b072e0; box-shadow: 0 0 0 3px rgba(176, 114, 224, .18); }
			.btn {
				width: 100%;
				margin-top: 8px;
				padding: 12px;
				border: 0;
				border-radius: 10px;
				background: linear-gradient(135deg, #a24bd8, #e0579a);
				color: #fff;
				font-size: 15px;
				letter-spacing: .16em;
				cursor: pointer;
				transition: filter .2s, transform .1s;
			}
			.btn:hover { filter: brightness(1.08); }
			.btn:active { transform: scale(.98); }
			.btn:disabled { opacity: .6; cursor: not-allowed; }
			.msg { min-height: 18px; margin-top: 12px; font-size: 12.5px; color: #ff8fa3; }
			.switch { margin-top: 16px; font-size: 12.5px; color: #a893bd; text-align: center; }
			.switch a { color: #d59cff; text-decoration: none; }
			.switch a:hover { text-decoration: underline; }
		</style>
	</head>
	<body>
		<div class="card" id="card">
			<h1>欢迎回来<span class="dot"> · </span>欢愉剧场</h1>
			<p class="sub">登录后进入剧场</p>
			<form id="form">
				<div class="field">
					<label>账号（昵称）</label>
					<input type="text" name="name" placeholder="请输入注册的昵称" maxlength="20" autofocus required />
				</div>
				<div class="field">
					<label>密码</label>
					<input type="password" name="password" placeholder="请输入密码" required />
				</div>
				<button class="btn" type="submit" id="submit">登 录</button>
			</form>
			<div class="msg" id="msg"></div>
			<p class="switch">还没有账号？<a href="/register">去注册</a></p>
		</div>
		<script>
			const form = document.getElementById("form");
			const msg = document.getElementById("msg");
			const btn = document.getElementById("submit");
			const params = new URLSearchParams(location.search);
			const next = params.get("next") || "/";

			form.addEventListener("submit", async (e) => {
				e.preventDefault();
				msg.textContent = "";
				btn.disabled = true;
				btn.textContent = "登录中…";
				try {
					const fd = new FormData(form);
					const res = await fetch("/api/auth/login", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ name: fd.get("name"), password: fd.get("password") }),
					});
					const data = await res.json();
					if (res.ok) {
						location.replace(next.startsWith("/") ? next : "/");
					} else {
						msg.textContent = data.error || "登录失败";
						btn.disabled = false;
						btn.textContent = "登 录";
					}
				} catch {
					msg.textContent = "网络错误，稍后再试";
					btn.disabled = false;
					btn.textContent = "登 录";
				}
			});
		</script>
	</body>
</html>
