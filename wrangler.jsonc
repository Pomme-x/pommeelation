{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pommeelation",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "./dist",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "elation-db",
			"database_id": "REPLACE_WITH_D1_ID"
		}
	]
}
